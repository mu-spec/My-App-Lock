        {"day": 7, "minute": 1439, "floors": {"com.bank.app": "maximum", "com.kids.game": "maximum", "org.chat.app": "maximum"}, "effective": {"com.bank.app": "maximum", "com.kids.game": "maximum", "org.chat.app": "maximum"}}
      ]
    },
