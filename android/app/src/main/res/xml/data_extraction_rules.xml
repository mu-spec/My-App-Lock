<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 13 / M3 (Q-P13-6): Android 12+ (API 31+) backup and transfer rules.
  Nothing of Smart App Lock leaves the device: every domain is excluded from
  cloud backup and from device-to-device transfer. android:allowBackup="false"
  stays in the manifest. For apps targeting Android 12+, allowBackup="false"
  does not stop device-to-device transfer, so these rules are what keep the
  security data (encrypted settings, history, evidence, native protection
  state) off a new phone. No include rules. Keystore keys never transfer.
  Verified by test/regression/p13_m3_backup_rules_test.dart.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
